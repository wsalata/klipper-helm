#!/bin/sh
set -e

STATE_DIR=/var/lib/klipper-helm

if [ "$1" = remove ] || [ "$1" = purge ]; then
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		# Give the screen back to KlipperScreen if the package disabled it
		if [ -e "$STATE_DIR/klipperscreen-was-enabled" ]; then
			systemctl enable --now KlipperScreen.service || true
			rm -f "$STATE_DIR/klipperscreen-was-enabled"
			echo "klipper-helm: KlipperScreen enabled again"
		fi
	fi
fi

if [ "$1" = purge ]; then
	rm -rf /etc/systemd/system/klipper-helm.service.d "$STATE_DIR"
	[ -d /run/systemd/system ] && systemctl daemon-reload || true
fi

exit 0
