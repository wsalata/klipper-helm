#!/bin/sh
set -e

DROPIN_DIR=/etc/systemd/system/klipper-helm.service.d
STATE_DIR=/var/lib/klipper-helm

# The panel runs as the user Moonraker runs as (its settings go to that user's ~/.config)
find_user() {
	user=$(systemctl show -p User --value moonraker.service 2>/dev/null || true)
	[ -n "$user" ] && [ "$user" != root ] && { echo "$user"; return; }
	for d in /home/*/printer_data; do
		[ -d "$d" ] && { stat -c %U "$d"; return; }
	done
	getent passwd 1000 | cut -d: -f1
}

if [ "$1" = configure ]; then
	if [ ! -e "$DROPIN_DIR/10-user.conf" ]; then
		user=$(find_user)
		if [ -n "$user" ]; then
			mkdir -p "$DROPIN_DIR"
			printf '# Created by the klipper-helm package; edit to run the panel as another user\n[Service]\nUser=%s\n' \
				"$user" > "$DROPIN_DIR/10-user.conf"
			echo "klipper-helm: running the panel as user $user"
		else
			echo "klipper-helm: no user found; set User= in $DROPIN_DIR/10-user.conf" >&2
		fi
	fi

	# Lets Moonraker (and Mainsail) restart the panel
	user=$(sed -n 's/^User=//p' "$DROPIN_DIR/10-user.conf" 2>/dev/null || true)
	home=$(getent passwd "$user" | cut -d: -f6)
	asvc="$home/printer_data/moonraker.asvc"
	if [ -n "$home" ] && [ -f "$asvc" ] && ! grep -qx klipper-helm "$asvc"; then
		echo klipper-helm >> "$asvc"
	fi

	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload
		# Only one program can draw on the screen; KlipperScreen comes back when this
		# package is removed
		if systemctl is-enabled --quiet KlipperScreen.service 2>/dev/null; then
			mkdir -p "$STATE_DIR"
			touch "$STATE_DIR/klipperscreen-was-enabled"
			systemctl disable --now KlipperScreen.service || true
			echo "klipper-helm: KlipperScreen disabled"
		fi
		systemctl enable klipper-helm.service
		systemctl restart klipper-helm.service || true
	fi
fi

exit 0
