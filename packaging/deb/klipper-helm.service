[Unit]
Description=Klipper Helm touch screen panel
Documentation=https://github.com/wsalata/klipper-helm
After=moonraker.service systemd-user-sessions.service
Wants=moonraker.service
# Both draw directly on the screen
Conflicts=KlipperScreen.service

[Service]
Type=simple
# The user is set by the package (/etc/systemd/system/klipper-helm.service.d/10-user.conf):
# the one Moonraker runs as, so the panel's settings live in that user's ~/.config
SupplementaryGroups=video input render
# Tells the Updates screen that new versions come as Debian packages
Environment=KLIPPER_HELM_PACKAGE=deb
EnvironmentFile=-/etc/default/locale
EnvironmentFile=-/etc/default/klipper-helm
ExecStart=/usr/lib/klipper-helm/klipper-helm-start
Restart=always
RestartSec=3
# Klipper's host process must never wait for the screen
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
