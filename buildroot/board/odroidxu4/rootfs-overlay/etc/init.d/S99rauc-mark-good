#!/bin/sh
#
# Reaching the end of the boot means this system works: tell RAUC, which resets
# the slot's boot counter in U-Boot. Without this, U-Boot falls back to the
# other slot after three failed boots.
#

case "$1" in
start)
	mkdir -p /data/rauc
	printf "Marking this system good: "
	rauc status mark-good booted >/dev/null 2>&1 && echo "OK" || echo "FAIL"
	;;
stop)
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
