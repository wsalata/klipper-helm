#!/bin/sh
#
# Mounts the writable "data" partition on /data (panel settings).
# The root filesystem stays read-only, so pulling the plug cannot corrupt it.
#

find_device() {
	for i in 1 2 3 4 5; do
		[ -e /dev/disk/by-label/data ] && { echo /dev/disk/by-label/data; return; }
		sleep 1
	done
	findfs LABEL=data 2>/dev/null
}

case "$1" in
start)
	printf "Mounting /data: "
	dev=$(find_device)
	if [ -z "$dev" ]; then
		echo "FAIL (no partition labelled data)"
		exit 1
	fi
	# Repair what a power loss may have left behind
	fsck.ext4 -p "$dev" >/dev/null 2>&1
	if mount -t ext4 -o noatime "$dev" /data; then
		echo "OK"
	else
		echo "FAIL"
		exit 1
	fi
	;;
stop)
	umount /data
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
