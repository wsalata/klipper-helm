#!/bin/sh
#
# Keeps the clock in sync (the board has no battery-backed clock by default).
#

case "$1" in
start)
	printf "Starting ntpd: "
	start-stop-daemon -S -b -q -x /usr/sbin/ntpd -- -n -p pool.ntp.org && echo "OK" || echo "FAIL"
	;;
stop)
	printf "Stopping ntpd: "
	start-stop-daemon -K -q -x /usr/sbin/ntpd && echo "OK" || echo "FAIL"
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
