#!/bin/sh
# Starts the panel; init runs this from /etc/inittab and starts it again
# whenever it exits (crash, or the panel being killed).

export SLINT_BACKEND=linuxkms-software
export KLIPPER_HELM_CONFIG=/data/klipper-helm/config.toml
# The panel may change the network setup (System -> Network)
export KLIPPER_HELM_MANAGE_NETWORK=1
export KLIPPER_HELM_DHCPCD_CONF=/data/network/dhcpcd.conf
# Only picks the UI language when the settings say "System"
export LANG=pl_PL.UTF-8

# Scale the UI (designed for 800x480) to fill the screen: 1024x600 -> 1.25,
# 1280x720 -> 1.5. Uses the first (preferred) mode of the connected display.
for c in /sys/class/drm/card*-*; do
	[ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
	mode=$(head -n 1 "$c/modes")
	[ -n "$mode" ] && export SLINT_SCALE_FACTOR=$(echo "$mode" | awk -Fx \
		'{ s = $1 / 800; if ($2 / 480 < s) s = $2 / 480; if (s < 1) s = 1; printf "%.2f", s }')
	break
done

# Per-device overrides, e.g. SLINT_KMS_ROTATION=180 or SLINT_SCALE_FACTOR=1
[ -r /data/klipper-helm/env ] && . /data/klipper-helm/env

mkdir -p /data/klipper-helm 2>/dev/null

# Diagnostics on the data partition, readable by putting the card into a PC.
# Written once per boot (the marker lives in /tmp, which is RAM).
LOGS=/data/logs
if [ ! -e /tmp/.logs-saved ] && mkdir -p $LOGS 2>/dev/null; then
	touch /tmp/.logs-saved
	# Give the display and input drivers time to settle before the snapshot
	sleep 3
	dmesg > $LOGS/dmesg.txt
	for c in /sys/class/drm/card*-*; do
		[ -e "$c/status" ] || continue
		echo "== ${c##*/}: $(cat $c/status) / $(cat $c/enabled)"
		cat "$c/modes"
		[ -s "$c/edid" ] && cp "$c/edid" "$LOGS/edid-${c##*/}.bin"
	done > $LOGS/drm.txt 2>&1
	cat /proc/bus/input/devices > $LOGS/input.txt 2>&1
	ls -l /dev/dri /dev/input > $LOGS/dev.txt 2>&1
	: > $LOGS/klipper-helm.log
fi

LOG=$LOGS/klipper-helm.log
[ -w $LOGS ] || LOG=/tmp/klipper-helm.log
# Keep the log small if the panel keeps failing
[ -f $LOG ] && [ "$(wc -c < $LOG)" -gt 1048576 ] && : > $LOG

echo "=== start $(date), scale ${SLINT_SCALE_FACTOR:-1}" >> $LOG
/usr/bin/klipper-helm >> $LOG 2>&1
echo "=== exited with status $?" >> $LOG

# Avoid a tight restart loop when something is badly wrong (no display, ...)
sleep 2
