# Added on top of exynos_defconfig for the panel

# HDMI output through the Exynos DRM driver (the panel draws via KMS)
CONFIG_DRM=y
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS_MIXER=y
CONFIG_DRM_EXYNOS_HDMI=y

# USB touch screens (HID multitouch and older resistive controllers)
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_USB_COMPOSITE=y

# Gigabit Ethernet: RTL8153 behind the USB 3.0 controller
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=y

# CPU fan driven by the thermal framework
CONFIG_SENSORS_PWM_FAN=y

# USB Wi-Fi adapters (modules, loaded by udev when an adapter is plugged in)
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
# Realtek RTL8188CU/EU, RTL8192CU/EU, RTL8723BU
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
# Realtek RTL8821CU, RTL8822BU/CU, RTL8723DU
CONFIG_RTW88=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8723DU=m
# MediaTek MT7601U and MT7921AU
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_MT7921U=m
# Ralink/MediaTek RT2870/RT3070/RT5370
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
# Atheros AR9271
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m

# RAUC update bundles: verity-protected squashfs images mounted through loop devices
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y
