# Added on top of exynos_defconfig for the panel

# HDMI output through the Exynos DRM driver (the panel draws via KMS)
CONFIG_DRM=y
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS_MIXER=y
CONFIG_DRM_EXYNOS_HDMI=y

# USB touch screens (HID multitouch and older resistive controllers)
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_USB_COMPOSITE=y

# Gigabit Ethernet: RTL8153 behind the USB 3.0 controller
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=y

# CPU fan driven by the thermal framework
CONFIG_SENSORS_PWM_FAN=y
