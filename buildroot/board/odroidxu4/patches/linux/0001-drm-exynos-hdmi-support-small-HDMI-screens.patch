@@ -916,9 +1103,30 @@
 	const struct hdmiphy_configs *confs = &hdata->drv_data->phy_confs;
 	int i;
 
-	for (i = 0; i < confs->count; i++)
-		if (confs->data[i].pixel_clock == pixel_clock)
-			return i;
+	u32 best_diff = U32_MAX;
+	int best = -EINVAL;
+
+	for (i = 0; i < confs->count; i++) {
+		u32 diff = abs(confs->data[i].pixel_clock - (int)pixel_clock);
+
+		if (diff < best_diff) {
+			best_diff = diff;
+			best = i;
+		}
+	}
+
+	/*
+	 * Screens rarely ask for one of the table's clocks exactly. A PHY clock
+	 * within 2% only shifts the refresh rate slightly, which HDMI receivers
+	 * accept, so use the nearest one instead of rejecting the mode.
+	 */
+	if (best >= 0 && best_diff <= pixel_clock / 50) {
+		if (best_diff)
+			DRM_DEV_DEBUG_KMS(hdata->dev,
+					  "Using phy config %d for %d\n",
+					  confs->data[best].pixel_clock, pixel_clock);
+		return best;
+	}
 
 	DRM_DEV_DEBUG_KMS(hdata->dev, "Could not find phy config for %d\n",
 			  pixel_clock);
