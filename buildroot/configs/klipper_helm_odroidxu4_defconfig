# Klipper Helm panel image for the Odroid XU4 (Exynos 5422) with an HDMI screen
# and a USB touch screen. Build: make image (see buildroot/README.md).

# CPU and toolchain (glibc, hard float, as Rust requires)
BR2_arm=y
BR2_cortex_a15_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y

# System: read-only root, udev for libinput
BR2_TARGET_GENERIC_HOSTNAME="klipper-helm"
BR2_TARGET_GENERIC_ISSUE="Klipper Helm"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_TARGET_GENERIC_GETTY_PORT="ttySAC2"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Europe/Warsaw"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KLIPPER_HELM_PATH)/board/odroidxu4/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_KLIPPER_HELM_PATH)/board/odroidxu4/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_KLIPPER_HELM_PATH)/board/odroidxu4/post-image.sh"
# Kernel patches (HDMI PHY settings for small screens)
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_KLIPPER_HELM_PATH)/board/odroidxu4/patches"

# Kernel: mainline LTS with HDMI, USB touch and Ethernet on top of exynos_defconfig
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.112"
BR2_LINUX_KERNEL_DEFCONFIG="exynos"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_KLIPPER_HELM_PATH)/board/odroidxu4/linux.fragment"
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="samsung/exynos5422-odroidxu4"
# Kernel and DTB live in each root filesystem (/boot), so an update replaces them too
BR2_LINUX_KERNEL_INSTALL_TARGET=y
# Boot logo until the panel starts (rendered by board/odroidxu4/make-boot-logo.sh)
BR2_LINUX_KERNEL_CUSTOM_LOGO_PATH="$(BR2_EXTERNAL_KLIPPER_HELM_PATH)/board/odroidxu4/boot-logo.png"

# Networking: dhcpcd on every interface, wpa_supplicant for USB Wi-Fi adapters
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
# Needed for the -s (log to syslog) option used in S38wifi
BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7601U=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_9271=y

# Updates: RAUC A/B root filesystems, U-Boot environment access, signed bundles
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_JSON=y
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_UBOOT_TOOLS_FWPRINTENV=y
BR2_PACKAGE_HOST_RAUC=y

# Userspace
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_KLIPPER_HELM_PATH)/board/odroidxu4/busybox.fragment"
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_MONO=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y
BR2_PACKAGE_HOST_RUST_BIN=y
BR2_PACKAGE_KLIPPER_HELM=y
BR2_PACKAGE_ODROIDXU4_BLOBS=y

# Root filesystem image
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="200M"
# BR2_TARGET_ROOTFS_TAR is not set

# Bootloader: mainline U-Boot (odroid-xu3 covers the XU4), after Hardkernel's signed blobs
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_LATEST_VERSION=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="odroid-xu3"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_FORMAT_DTB_BIN=y
# mkimage, for the A/B boot script (post-image.sh compiles board/odroidxu4/boot.cmd to boot.scr)
BR2_PACKAGE_HOST_UBOOT_TOOLS=y

# Host tools for assembling sdcard.img
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
