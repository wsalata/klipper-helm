{
    // Ctrl+Shift+P → "Tasks: Run Task", or Ctrl+Shift+B (default build)
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Mock Moonraker",
            "detail": "Fake Moonraker on 127.0.0.1:7125 (runs in the background)",
            "type": "shell",
            "command": "cargo run --example mock_moonraker",
            "isBackground": true,
            // The task counts as ready once the mock prints its address (needed for dependsOn/preLaunchTask)
            "problemMatcher": {
                "owner": "mock-moonraker",
                "pattern": { "regexp": "^__never_matches__$" },
                "background": {
                    "activesBegin": true,
                    "beginsPattern": "Compiling|Finished|Running",
                    "endsPattern": "Mock Moonraker on ws://"
                }
            },
            "presentation": { "panel": "dedicated", "reveal": "silent" }
        },
        {
            "label": "Panel (mock)",
            "detail": "Starts the mock and a panel connected to it",
            "type": "shell",
            "command": "cargo run",
            // Separate settings file, so the mock does not mix with a real printer
            "options": {
                "env": {
                    "MOONRAKER_URL": "ws://127.0.0.1:7125/websocket",
                    "KLIPPER_HELM_CONFIG": "${workspaceFolder}/target/dev-mock.toml"
                }
            },
            "dependsOn": "Mock Moonraker",
            "problemMatcher": ["$rustc"],
            "presentation": { "panel": "dedicated" }
        },
        {
            "label": "Panel (printer)",
            "detail": "Normal settings (~/.config/klipper-helm); change the address in System → Panel settings",
            "type": "shell",
            "command": "cargo run",
            "problemMatcher": ["$rustc"],
            "presentation": { "panel": "dedicated" }
        },
        {
            "label": "cargo build",
            "type": "shell",
            "command": "cargo build",
            "problemMatcher": ["$rustc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "cargo build --release",
            "type": "shell",
            "command": "cargo build --release",
            "problemMatcher": ["$rustc"],
            "group": "build"
        }
    ]
}
