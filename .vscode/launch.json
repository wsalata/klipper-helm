{
    // Debugging (F5) needs the CodeLLDB extension: vadimcorp.vscode-lldb
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Panel (mock)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=klipper-helm", "--package=klipper-helm"],
                "filter": { "name": "klipper-helm", "kind": "bin" }
            },
            "env": {
                "MOONRAKER_URL": "ws://127.0.0.1:7125/websocket",
                "KLIPPER_HELM_CONFIG": "${workspaceFolder}/target/dev-mock.toml"
            },
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Mock Moonraker"
        },
        {
            "name": "Panel (printer)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=klipper-helm", "--package=klipper-helm"],
                "filter": { "name": "klipper-helm", "kind": "bin" }
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Mock Moonraker",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--example=mock_moonraker", "--package=klipper-helm"],
                "filter": { "name": "mock_moonraker", "kind": "example" }
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}
