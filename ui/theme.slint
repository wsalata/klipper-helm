export global Theme {
    out property <color> bg: #14161b;
    out property <color> surface: #1e222a;
    out property <color> surface-2: #2a303b;
    out property <color> border: #353c49;
    out property <color> text: #e8eaed;
    out property <color> text-dim: #9aa1ad;
    out property <color> accent: #4f9cf7;
    out property <color> ok: #3fb950;
    out property <color> warn: #e3a52f;
    out property <color> danger: #e5534b;
    out property <color> hot: #f0883e;

    out property <length> radius: 10px;
    out property <length> gap: 8px;
    out property <length> font-s: 14px;
    out property <length> font-m: 18px;
    out property <length> font-l: 24px;
    out property <length> font-xl: 34px;
    out property <string> mono: "DejaVu Sans Mono";
}
