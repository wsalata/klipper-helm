// Data and actions shared by all screens.
// `Printer` is filled from Rust, `Actions` callbacks are handled in Rust.
// User-visible text is produced here with @tr(); Rust only sends codes and raw data.

export enum Conn { connecting, disconnected, not-ready, ready }

export enum Status {
    connecting,
    disconnected,
    klipper-starting,
    klipper-shutdown,
    klipper-error,
    klipper-connecting,
    klipper-unavailable,
    ready,
    busy,
    printing,
    paused,
    complete,
    cancelled,
    print-error,
}

export struct Heater {
    id: string,        // Klipper object name, e.g. "extruder", "heater_generic chamber"
    role: string,      // "nozzle", "bed" or "" (generic, use `name`)
    number: int,       // nozzle number for multi-extruder setups, 0 when there is only one
    name: string,      // label for generic objects, taken from the Klipper config
    temp: float,
    target: float,
    power: float,      // 0..1
    settable: bool,
}

export struct Fan {
    id: string,
    role: string,      // "part" or "" (generic, use `name`)
    name: string,
    speed: float,      // 0..1
    settable: bool,
}

export struct FileEntry {
    path: string,
    thumb: image,
    size: string,
    modified: string,
}

export struct FileDetails {
    path: string,
    estimated: string,
    filament: string,
    slicer: string,
    layer-height: string,
}

// kind: 0 = response, 1 = command, 2 = error, 3 = info (//)
export struct ConsoleLine {
    text: string,
    kind: int,
}

export struct WifiNetwork {
    ssid: string,
    signal: float,     // 0..1
    secure: bool,
    current: bool,     // connected now
    saved: bool,       // known to wpa_supplicant
}

export struct Preset {
    name: string,
    extruder: float,
    bed: float,
}

export struct PrintJob {
    state: string,     // standby / printing / paused / complete / cancelled / error
    filename: string,
    progress: float,   // 0..1
    elapsed: string,
    remaining: string,
    remaining-minutes: int,  // -1 when unknown
    eta-clock: string,       // local "HH:MM" when the print should finish, "" when unknown
    layer: string,
    filament: string,
    message: string,
    speed-factor: int, // %
    flow-factor: int,  // %
    z-offset: string,
}

export struct Position {
    x: string,
    y: string,
    z: string,
    homed-x: bool,
    homed-y: bool,
    homed-z: bool,
}

export global Printer {
    in property <Conn> conn: Conn.connecting;
    in property <Status> status: Status.connecting;
    // Raw message from Klipper (e.g. shutdown reason); empty when not relevant
    in property <string> status-message;
    in property <string> hostname: "Klipper";
    in property <string> klipper-version;
    in property <string> moonraker-url;
    in property <string> clock;

    in property <[Heater]> heaters;
    in property <[Heater]> sensors;
    // Nozzle and bed, shown in the top bar
    in property <[Heater]> top-heaters;
    in property <[Fan]> fans;
    // Part cooling fan ("fan"), shown on the dashboard
    in property <bool> has-part-fan;
    in property <float> part-fan;
    in property <PrintJob> job;
    in property <image> job-thumb;
    in property <Position> position;
    in property <float> extruder-temp;
    in property <bool> has-extruder;
    in property <[string]> macros;
    in property <[FileEntry]> files;
    in property <FileDetails> details;
    in property <image> details-thumb;
    in property <[ConsoleLine]> console;
    // Console input line, split at the cursor
    in property <string> console-before;
    in property <string> console-after;
    in property <[Preset]> presets;

    in-out property <string> toast;
    in-out property <bool> toast-error: true;

    out property <bool> printing: job.state == "printing" || job.state == "paused";
}

// Translated labels for codes sent from Rust.
export global Strings {
    public pure function status(s: Status) -> string {
        if (s == Status.connecting) { return @tr("Connecting..."); }
        if (s == Status.disconnected) { return @tr("No connection"); }
        if (s == Status.klipper-starting) { return @tr("Klipper is starting"); }
        if (s == Status.klipper-shutdown) { return @tr("Klipper shut down"); }
        if (s == Status.klipper-error) { return @tr("Klipper error"); }
        if (s == Status.klipper-connecting) { return @tr("Connecting to Klipper..."); }
        if (s == Status.klipper-unavailable) { return @tr("Klipper unavailable"); }
        if (s == Status.busy) { return @tr("Busy"); }
        if (s == Status.printing) { return @tr("Printing"); }
        if (s == Status.paused) { return @tr("Paused"); }
        if (s == Status.complete) { return @tr("Complete"); }
        if (s == Status.cancelled) { return @tr("Cancelled"); }
        if (s == Status.print-error) { return @tr("Print error"); }
        return @tr("Ready");
    }

    public pure function status-message() -> string {
        if (Printer.status == Status.disconnected) {
            return @tr("Cannot connect to Moonraker ({})", Printer.moonraker-url);
        }
        return Printer.status-message;
    }

    public pure function heater-name(h: Heater) -> string {
        if (h.role == "nozzle") {
            return h.number > 0 ? @tr("Nozzle {}", h.number) : @tr("Nozzle");
        }
        if (h.role == "bed") { return @tr("Bed"); }
        return h.name;
    }

    public pure function fan-name(f: Fan) -> string {
        if (f.role == "part") { return @tr("Part cooling"); }
        return f.name;
    }

    public pure function wifi-state(state: string) -> string {
        if (state == "connected") { return @tr("Connected"); }
        if (state == "connecting") { return @tr("Connecting..."); }
        if (state == "unavailable") { return @tr("Wi-Fi service not running"); }
        return @tr("Not connected");
    }

    public pure function network-error(code: string, arg: string) -> string {
        if (code == "ip-address") { return @tr("Invalid IP address: {} (e.g. 192.168.1.20/24)", arg); }
        if (code == "ip-gateway") { return @tr("Invalid gateway: {}", arg); }
        if (code == "ip-dns") { return @tr("Invalid DNS server: {}", arg); }
        if (code == "save") { return @tr("Could not save settings: {}", arg); }
        if (code == "apply") { return @tr("Could not apply the change: {}", arg); }
        return arg;
    }

    public pure function settings-error(code: string, arg: string) -> string {
        if (code == "url") { return @tr("Moonraker address must start with ws:// or wss:// and contain no spaces"); }
        if (code == "speed") { return @tr("{} speed must be between 0.1 and 1000 mm/s", arg); }
        if (code == "preset-name") { return @tr("Every preset needs a name"); }
        if (code == "preset-temp") { return @tr("Preset {}: temperature out of range", arg); }
        if (code == "save") { return @tr("Could not save settings: {}", arg); }
        return arg;
    }
}

// Notifications that Rust triggers by name, so their text can be translated.
export global Messages {
    public function no-connection() {
        Printer.toast-error = true;
        Printer.toast = @tr("No connection to Moonraker");
    }

    public function settings-saved() {
        Printer.toast-error = false;
        Printer.toast = @tr("Settings saved");
    }
}

// Names for special keys from a physical keyboard, as understood by the Rust line editor.
export global Keys {
    public pure function name(text: string) -> string {
        if (text == Key.Backspace) { return "BS"; }
        if (text == Key.Delete) { return "DEL"; }
        if (text == Key.LeftArrow) { return "LEFT"; }
        if (text == Key.RightArrow) { return "RIGHT"; }
        if (text == Key.Home) { return "HOME"; }
        if (text == Key.End) { return "END"; }
        if (text == Key.Return) { return "ENTER"; }
        return text;
    }
}

export global Actions {
    callback gcode(string);
    callback console-key(string);
    // Key pressed in the text editor dialog (edits Overlay.text-before/-after)
    callback text-key(string);
    callback set-temp(string, float);
    callback set-fan(string, float);
    callback jog(string, float);
    callback extrude(float, float);
    callback pause();
    callback resume();
    callback cancel();
    callback emergency-stop();
    callback restart();
    callback firmware-restart();
    callback refresh-files();
    callback file-details(string);
    callback start-print(string);
    callback host-reboot();
    callback host-shutdown();
}

// Draft of the panel settings edited on the Settings screen; saving applies them immediately.
export global Settings {
    in-out property <string> url;
    in-out property <float> xy-speed;
    in-out property <float> z-speed;
    // "auto", "en" or "pl"
    in-out property <string> language;
    in property <[Preset]> presets;
    in property <string> config-path;
    // Validation/save error, translated with Strings.settings-error
    in-out property <string> error-code;
    in-out property <string> error-arg;

    // Fills the draft from the current configuration
    callback load();
    callback save();
    callback preset-add(string);
    callback preset-remove(int);
    // Dialog results; id: "xy", "z", "ext:N", "bed:N", "url", "name:N"
    callback edit-number(string, float);
    callback edit-text(string, string);
}

// Network screen: status pushed from Rust every few seconds, plus the Ethernet draft.
export global Network {
    // false on a PC: status only, no changes to the system's network setup
    in property <bool> managed;
    in property <string> eth-name;
    in property <bool> eth-up;
    in property <string> eth-ip;
    in property <bool> wifi-present;
    // "connected", "connecting", "disconnected" or "unavailable"
    in property <string> wifi-state;
    in property <string> wifi-ssid;
    in property <string> wifi-ip;
    in property <bool> scanning;
    in property <[WifiNetwork]> networks;

    in-out property <bool> eth-static;
    in-out property <string> eth-address;
    in-out property <string> eth-gateway;
    in-out property <string> eth-dns;
    in-out property <string> error-code;
    in-out property <string> error-arg;

    // Fills the Ethernet draft from the settings and starts a Wi-Fi scan
    callback load();
    callback scan();
    callback connect(string, string);   // ssid, password ("" for open networks)
    callback connect-hidden(string, string);
    callback forget(string);
    callback apply-ethernet();
    // Text dialog results; id: "eth-address", "eth-gateway", "eth-dns"
    callback edit-text(string, string);
}

export global Nav {
    in-out property <int> page: 0;
}

// State of dialogs drawn over the screens (numpad, confirmation, text editor, file).
export global Overlay {
    in-out property <bool> numpad-open;
    // "temp" sets a heater target, "settings" returns the value to Settings
    in-out property <string> numpad-purpose;
    in-out property <string> numpad-unit;
    in-out property <string> numpad-title;
    in-out property <string> numpad-id;
    in-out property <string> numpad-hint;
    in-out property <string> numpad-value;

    in-out property <bool> confirm-open;
    in-out property <string> confirm-text;
    in-out property <string> confirm-action;
    in-out property <string> confirm-arg;

    in-out property <bool> text-open;
    // "settings", "network", "wifi" (the id is then the SSID to join),
    // "hidden-ssid" (asks for a hidden network's name) or "hidden-wifi" (its password)
    in-out property <string> text-purpose;
    in-out property <string> text-title;
    in-out property <string> text-id;
    // Edited text, split at the cursor
    in-out property <string> text-before;
    in-out property <string> text-after;

    in-out property <bool> file-open;
    in-out property <string> file-path;

    in-out property <bool> menu-open;
    in-out property <bool> tune-open;

    public function ask(text: string, action: string, arg: string) {
        confirm-text = text;
        confirm-action = action;
        confirm-arg = arg;
        confirm-open = true;
    }

    public function edit-temp(heater: Heater) {
        numpad-title = @tr("{} - target temperature", Strings.heater-name(heater));
        numpad-purpose = "temp";
        numpad-unit = "°";
        numpad-id = heater.id;
        numpad-hint = round(heater.target) + "";
        numpad-value = "";
        numpad-open = true;
    }

    public function ask-number(id: string, title: string, current: float, unit: string) {
        numpad-title = title;
        numpad-purpose = "settings";
        numpad-unit = unit;
        numpad-id = id;
        numpad-hint = round(current) + "";
        numpad-value = "";
        numpad-open = true;
    }

    public function ask-text(id: string, title: string, current: string) {
        text-purpose = "settings";
        text-title = title;
        text-id = id;
        text-before = current;
        text-after = "";
        text-open = true;
    }

    public function ask-network-text(id: string, title: string, current: string) {
        ask-text(id, title, current);
        text-purpose = "network";
    }

    public function ask-wifi-password(ssid: string) {
        ask-text(ssid, @tr("Password for {}", ssid), "");
        text-purpose = "wifi";
    }

    public function ask-hidden-network() {
        ask-text("", @tr("Hidden network name (SSID)"), "");
        text-purpose = "hidden-ssid";
    }

    public function ask-hidden-password(ssid: string) {
        ask-text(ssid, @tr("Password for {} (empty for an open network)", ssid), "");
        text-purpose = "hidden-wifi";
    }

    public function open-file(path: string) {
        file-path = path;
        file-open = true;
    }
}
