import { Theme } from "theme.slint";
import { Heater, Strings, Screensaver, Actions } from "state.slint";

// danger-outline: a destructive action that is not an emergency (e.g. cancelling a print)
export enum BtnKind { normal, accent, danger, danger-outline, ghost }

export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <BtnKind> kind: BtnKind.normal;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <length> font-size: Theme.font-m;
    in property <length> icon-size: 22px;
    callback clicked();

    property <color> base: root.active ? Theme.accent
        : root.kind == BtnKind.accent ? Theme.accent
        : root.kind == BtnKind.danger ? Theme.danger
        : root.kind == BtnKind.ghost || root.kind == BtnKind.danger-outline ? transparent
        : Theme.surface-2;
    // Disabled keys are hollow with faded text, clearly apart from any working key
    property <color> fg: !root.enabled ? Theme.text-dim.transparentize(0.55)
        : (root.active || root.kind == BtnKind.accent) ? Theme.on-accent
        : root.kind == BtnKind.danger ? #ffffff
        : root.kind == BtnKind.danger-outline ? Theme.danger-text
        : Theme.text;

    min-height: 48px;
    min-width: 48px;
    // Pills, but keys taller than ~52 px stay rounded rectangles
    border-radius: min(self.height / 2, 26px);
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    // Disabled keys keep only a faint outline
    border-width: !root.enabled || root.kind == BtnKind.ghost || root.kind == BtnKind.danger-outline ? 1px : 0px;
    border-color: !root.enabled ? Theme.border.transparentize(0.4)
        : root.kind == BtnKind.danger-outline ? Theme.danger-border : Theme.border;
    background: !root.enabled ? transparent
        : ta.pressed ? (root.base == transparent ? Theme.surface-2 : root.base.darker(0.35))
        : root.base;
    animate background { duration: 80ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: root.text != "" ? 14px : 8px;
        padding-right: root.text != "" ? 14px : 8px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.fg;
                width: root.icon-size;
                height: root.icon-size;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: root.font-size;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Print thumbnail; slicers render them on a transparent background.
export component Thumb inherits Rectangle {
    in property <image> source;
    background: Theme.surface;
    border-radius: 12px;
    clip: true;
    Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-l;
}

export component Caption inherits Text {
    color: Theme.text-dim;
    font-size: Theme.font-s;
    vertical-alignment: center;
}

// Pick one of several options (e.g. the jog step).
export component Segmented inherits HorizontalLayout {
    in property <[string]> items;
    in-out property <int> selected;
    spacing: 4px;
    for item[i] in root.items: Btn {
        text: item;
        font-size: Theme.font-s;
        active: i == root.selected;
        clicked => { root.selected = i; }
    }
}

export component Bar inherits Rectangle {
    in property <float> value;
    in property <color> fill: Theme.accent;
    height: 6px;
    border-radius: self.height / 2;
    background: Theme.surface-2;
    Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.value));
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
    }
}

// Single-line text with a cursor between the parts before and after it.
export component CursorText inherits HorizontalLayout {
    in property <string> before;
    in property <string> after;
    in property <string> placeholder;
    alignment: start;
    Text {
        text: root.before;
        color: Theme.text;
        font-family: Theme.mono;
        vertical-alignment: center;
    }
    Rectangle {
        width: 2px;
        background: Theme.accent;
    }
    Text {
        text: root.after;
        color: Theme.text;
        font-family: Theme.mono;
        vertical-alignment: center;
    }
    if root.before == "" && root.after == "": Text {
        text: root.placeholder;
        color: Theme.text-dim;
        vertical-alignment: center;
    }
}

// "label  value" row for info cards.
export component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    Caption { text: root.label; horizontal-stretch: 0; }
    Text {
        text: root.value;
        color: Theme.text;
        horizontal-alignment: right;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

// Fan speed presets. The tapped preset lights up at once; Klipper applies M106 only after the
// moves already queued, so its reported speed follows a moment later.
export component FanSpeeds inherits HorizontalLayout {
    in property <string> fan-id;
    in property <float> speed;
    // Preset tapped since the last speed report, -1 when none
    property <int> chosen: -1;
    changed speed => { root.chosen = -1; }
    spacing: 4px;
    for v in [0, 25, 50, 75, 100]: Btn {
        text: v + "";
        font-size: Theme.font-s;
        min-height: 40px;
        active: (root.chosen >= 0 ? root.chosen : round(root.speed * 100)) == v;
        clicked => {
            root.chosen = v;
            Actions.set-fan(root.fan-id, v / 100);
        }
    }
}

// "label  value" box whose value is a key that opens the numpad.
export component ValueBox inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked();
    // Darker than the keys inside, so they read as buttons
    background: Theme.bg;
    border-radius: Theme.radius-l;
    height: 80px;
    preferred-width: 200px;
    horizontal-stretch: 1;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        Caption { text: root.label; overflow: elide; horizontal-stretch: 1; }
        Btn {
            text: root.value;
            width: 120px;
            font-size: Theme.font-l;
            accessible-label: root.label;
            clicked => { root.clicked(); }
        }
    }
}

// Step adjustment with - and + (Z offset).
export component Stepper inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback minus();
    callback plus();
    // Darker than the keys inside, so they read as buttons
    background: Theme.bg;
    border-radius: Theme.radius-l;
    height: 80px;
    // Equal widths side by side
    preferred-width: 200px;
    horizontal-stretch: 1;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        Btn {
            text: "-";
            width: 56px;
            font-size: Theme.font-l;
            accessible-label: @tr("Decrease {}", root.label);
            clicked => { root.minus(); }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Caption { text: root.label; horizontal-alignment: center; overflow: elide; }
            Text {
                text: root.value;
                color: Theme.text;
                font-family: Theme.display;
                font-size: Theme.font-l;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
        Btn {
            text: "+";
            width: 56px;
            font-size: Theme.font-l;
            accessible-label: @tr("Increase {}", root.label);
            clicked => { root.plus(); }
        }
    }
}

// Tappable "label  value" row that opens an editor.
export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked();
    height: 52px;
    border-radius: 8px;
    background: ta.pressed ? Theme.border : Theme.surface-2;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Caption { text: root.label; horizontal-stretch: 0; }
        Text {
            text: root.value;
            color: Theme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
        clicked => { root.clicked(); }
    }
}
