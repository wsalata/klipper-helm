import { Theme } from "theme.slint";
import { Printer, Actions, Overlay, Nav, Conn, Settings, Strings, Keys, Network, Screensaver, Update } from "state.slint";
import { Btn, BtnKind, Card, Caption, InfoRow, Thumb, CursorText, Stepper } from "widgets.slint";

// Dimmed backdrop that blocks touches to the screen below.
component Scrim inherits Rectangle {
    callback dismiss();
    background: #050a14c0;
    TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
        clicked => { root.dismiss(); }
    }
}

component Dialog inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: Theme.border;
    TouchArea {}  // swallows clicks so they do not close the dialog
}

export component NumpadDialog inherits Scrim {
    dismiss => { Overlay.numpad-open = false; }

    function press(k: string) {
        if (Overlay.numpad-value == "0") {
            Overlay.numpad-value = k;
        } else {
            Overlay.numpad-value = Overlay.numpad-value + k;
        }
    }
    function submit(value: string) {
        if (value.is-float()) {
            if (Overlay.numpad-purpose == "temp") {
                Actions.set-temp(Overlay.numpad-id, value.to-float());
            } else {
                Settings.edit-number(Overlay.numpad-id, value.to-float());
            }
        }
        Overlay.numpad-open = false;
    }

    Dialog {
        width: 320px;
        height: min(root.height - 16px, 420px);
        VerticalLayout {
            padding: 12px;
            spacing: 6px;
            Caption { text: Overlay.numpad-title; overflow: elide; }
            Rectangle {
                height: 52px;
                background: Theme.bg;
                border-radius: 8px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: (Overlay.numpad-value == "" ? Overlay.numpad-hint : Overlay.numpad-value) + Overlay.numpad-unit;
                        color: Overlay.numpad-value == "" ? Theme.text-dim : Theme.text;
                        font-size: Theme.font-xl;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
            HorizontalLayout { spacing: 6px; for k in ["7", "8", "9"]: Btn { text: k; clicked => { root.press(k); } } }
            HorizontalLayout { spacing: 6px; for k in ["4", "5", "6"]: Btn { text: k; clicked => { root.press(k); } } }
            HorizontalLayout { spacing: 6px; for k in ["1", "2", "3"]: Btn { text: k; clicked => { root.press(k); } } }
            HorizontalLayout {
                spacing: 6px;
                Btn { text: "C"; clicked => { Overlay.numpad-value = ""; } }
                Btn { text: "0"; clicked => { root.press("0"); } }
                if Overlay.numpad-purpose == "temp": Btn { text: @tr("Off"); font-size: Theme.font-s; clicked => { root.submit("0"); } }
                // The locale decimal separator, because to-float() parses with it ("," in Polish)
                if Overlay.numpad-purpose != "temp": Btn { text: Platform.decimal-separator; clicked => { root.press(Platform.decimal-separator); } }
            }
            HorizontalLayout {
                spacing: 6px;
                Btn { text: @tr("Cancel"); kind: BtnKind.ghost; clicked => { Overlay.numpad-open = false; } }
                Btn { text: @tr("Set"); kind: BtnKind.accent; clicked => { root.submit(Overlay.numpad-value); } }
            }
        }
    }
}

component TextKey inherits Btn {
    in property <string> key;
    in property <bool> upper;
    text: root.upper ? root.key.to-uppercase() : root.key;
    font-size: Theme.font-s;
    min-height: 40px;
    min-width: 30px;
    horizontal-stretch: 1;
    clicked => { Actions.text-key(self.text); }
}

// Text editing (address, names) with a full on-screen keyboard.
export component TextDialog inherits Scrim {
    dismiss => { Overlay.text-open = false; }
    property <bool> upper;

    // 0 = letters, 1 = symbols (Wi-Fi passwords may contain anything)
    property <int> layer;

    function submit() {
        let value = Overlay.text-before + Overlay.text-after;
        // Closed first, so a follow-up question (hidden network password) can open it again
        Overlay.text-open = false;
        if (Overlay.text-purpose == "wifi") {
            Network.connect(Overlay.text-id, value);
        } else if (Overlay.text-purpose == "hidden-ssid") {
            if (value != "") {
                Overlay.ask-hidden-password(value);
            }
        } else if (Overlay.text-purpose == "hidden-wifi") {
            Network.connect-hidden(Overlay.text-id, value);
        } else if (Overlay.text-purpose == "mesh-profile") {
            if (value != "") {
                Actions.calibrate-mesh(value);
            }
        } else if (Overlay.text-purpose == "network") {
            Network.edit-text(Overlay.text-id, value);
        } else {
            Settings.edit-text(Overlay.text-id, value);
        }
    }

    init => { fs.focus(); }

    Dialog {
        width: min(root.width - 16px, 760px);
        height: min(root.height - 16px, 420px);

        fs := FocusScope {
            // Physical keyboard (e.g. on a PC)
            key-pressed(e) => {
                Screensaver.activity();
                if (e.text == Key.Return) {
                    root.submit();
                } else if (e.text == Key.Escape) {
                    Overlay.text-open = false;
                } else {
                    Actions.text-key(Keys.name(e.text));
                }
                accept
            }

            VerticalLayout {
                padding: 12px;
                spacing: 5px;
                Caption { text: Overlay.text-title; }
                Rectangle {
                    height: 46px;
                    background: Theme.bg;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    clip: true;
                    CursorText {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        before: Overlay.text-before;
                        after: Overlay.text-after;
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    for k in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]: TextKey { key: k; }
                    Btn { text: @tr("Delete"); font-size: Theme.font-s; min-height: 40px; horizontal-stretch: 1.5; clicked => { Actions.text-key("BS"); } }
                }
                if root.layer == 0: HorizontalLayout {
                    spacing: 4px;
                    for k in ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p", "-"]: TextKey { key: k; upper: root.upper; }
                }
                if root.layer == 0: HorizontalLayout {
                    spacing: 4px;
                    for k in ["a", "s", "d", "f", "g", "h", "j", "k", "l", ":", "_"]: TextKey { key: k; upper: root.upper; }
                }
                if root.layer == 1: HorizontalLayout {
                    spacing: 4px;
                    for k in ["!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "-"]: TextKey { key: k; }
                }
                if root.layer == 1: HorizontalLayout {
                    spacing: 4px;
                    for k in ["+", "=", "?", ";", "'", "\"", ",", "[", "]", "{", "}"]: TextKey { key: k; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    if root.layer == 0: Btn {
                        text: root.upper ? "abc" : "ABC";
                        font-size: Theme.font-s;
                        min-height: 40px;
                        horizontal-stretch: 1.5;
                        active: root.upper;
                        clicked => { root.upper = !root.upper; }
                    }
                    if root.layer == 0: HorizontalLayout {
                        spacing: 4px;
                        horizontal-stretch: 9;
                        for k in ["z", "x", "c", "v", "b", "n", "m", ".", "/"]: TextKey { key: k; upper: root.upper; }
                    }
                    if root.layer == 1: HorizontalLayout {
                        spacing: 4px;
                        horizontal-stretch: 10.5;
                        for k in ["<", ">", "~", "`", "|", "\\", ":", "_", ".", "/"]: TextKey { key: k; }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Btn {
                        text: root.layer == 0 ? "#+=" : "abc";
                        font-size: Theme.font-s;
                        min-height: 40px;
                        active: root.layer == 1;
                        clicked => { root.layer = 1 - root.layer; }
                    }
                    Btn { text: "C"; font-size: Theme.font-s; min-height: 40px; clicked => { Actions.text-key("CLR"); } }
                    Btn { icon: @image-url("icons/left.svg"); min-height: 40px; clicked => { Actions.text-key("LEFT"); } }
                    Btn { icon: @image-url("icons/right.svg"); min-height: 40px; clicked => { Actions.text-key("RIGHT"); } }
                    Btn { text: @tr("space"); font-size: Theme.font-s; min-height: 40px; horizontal-stretch: 3; clicked => { Actions.text-key(" "); } }
                    Btn { text: @tr("Cancel"); kind: BtnKind.ghost; min-height: 40px; horizontal-stretch: 2; clicked => { Overlay.text-open = false; } }
                    Btn { text: "OK"; kind: BtnKind.accent; min-height: 40px; horizontal-stretch: 2; clicked => { root.submit(); } }
                }
            }
        }
    }
}

export component ConfirmDialog inherits Scrim {
    dismiss => { Overlay.confirm-open = false; }

    function run(action: string, arg: string) {
        if (action == "cancel") {
            Actions.cancel();
        } else if (action == "restart") {
            Actions.restart();
        } else if (action == "firmware-restart") {
            Actions.firmware-restart();
        } else if (action == "reboot") {
            Actions.host-reboot();
        } else if (action == "shutdown") {
            Actions.host-shutdown();
        } else if (action == "gcode") {
            Actions.gcode(arg);
        } else if (action == "update") {
            Update.upgrade(arg);
        } else if (action == "wifi-join") {
            Network.connect(arg, "");
        } else if (action == "wifi-forget") {
            Network.forget(arg);
        }
    }

    Dialog {
        width: min(root.width - 32px, 440px);
        height: 190px;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            Text {
                text: Overlay.confirm-text;
                color: Theme.text;
                font-size: Theme.font-m;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                vertical-stretch: 1;
            }
            HorizontalLayout {
                spacing: Theme.gap;
                Btn { text: @tr("No"); kind: BtnKind.ghost; clicked => { Overlay.confirm-open = false; } }
                Btn {
                    text: @tr("Yes");
                    kind: Overlay.confirm-action == "gcode" ? BtnKind.accent : BtnKind.danger;
                    clicked => {
                        Overlay.confirm-open = false;
                        root.run(Overlay.confirm-action, Overlay.confirm-arg);
                    }
                }
            }
        }
    }
}

export component FileDialog inherits Scrim {
    dismiss => { Overlay.file-open = false; }
    property <bool> loaded: Printer.details.path == Overlay.file-path;

    Dialog {
        width: min(root.width - 32px, 620px);
        height: min(root.height - 16px, 330px);
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text {
                text: Overlay.file-path;
                color: Theme.text;
                font-size: Theme.font-m;
                font-weight: 700;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 16px;
                vertical-stretch: 1;
                if root.loaded && Printer.details-thumb.width > 0: Thumb {
                    source: Printer.details-thumb;
                    width: 170px;
                }
                VerticalLayout {
                    spacing: 10px;
                    InfoRow { label: @tr("Estimated time"); value: root.loaded ? Printer.details.estimated : "..."; }
                    InfoRow { label: @tr("Filament"); value: root.loaded ? Printer.details.filament : "..."; }
                    InfoRow { label: @tr("Layer height"); value: root.loaded ? Printer.details.layer-height : "..."; }
                    InfoRow { label: @tr("Slicer"); value: root.loaded ? Printer.details.slicer : "..."; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            HorizontalLayout {
                spacing: Theme.gap;
                Btn { text: @tr("Close"); kind: BtnKind.ghost; clicked => { Overlay.file-open = false; } }
                Btn {
                    text: @tr("Print");
                    kind: BtnKind.accent;
                    enabled: Printer.conn == Conn.ready && !Printer.printing;
                    clicked => {
                        Actions.start-print(Overlay.file-path);
                        Overlay.file-open = false;
                        Nav.page = 0;
                    }
                }
            }
        }
    }
}

// Shown instead of a screen when Klipper is not ready or there is no connection.
// Logo with the "klipperhelm" wordmark, as on the boot screen
component Wordmark inherits HorizontalLayout {
    in property <length> size: 50px;
    alignment: center;
    Text {
        text: "klipper";
        color: Theme.text;
        font-size: root.size;
        font-weight: 500;
    }
    Text {
        text: "helm";
        color: Theme.accent;
        font-size: root.size;
        font-weight: 600;
    }
}

export component NotReadyPanel inherits Rectangle {
    background: Theme.bg;

    // Starting up: a welcome screen until Moonraker answers (or fails to)
    if Printer.conn == Conn.connecting: VerticalLayout {
        alignment: center;
        spacing: 18px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/logo.svg");
                width: 150px;
                height: 150px;
            }
        }
        Wordmark {}
        Text {
            text: Strings.status(Printer.status);
            color: Theme.text-dim;
            horizontal-alignment: center;
        }
    }

    if Printer.conn != Conn.connecting: VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/logo.svg");
                width: 64px;
                height: 64px;
            }
        }
        Text {
            text: Strings.status(Printer.status);
            color: Printer.conn == Conn.connecting ? Theme.text : Theme.warn;
            font-size: Theme.font-l;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: Strings.status-message();
            color: Theme.text-dim;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        // No Moonraker: the address may be wrong, so its setting is one tap away
        if Printer.conn != Conn.not-ready: HorizontalLayout {
            alignment: center;
            spacing: Theme.gap;
            Btn {
                text: @tr("Connection settings");
                kind: BtnKind.accent;
                width: 280px;
                clicked => {
                    Settings.load();
                    Nav.page = 8;
                }
            }
            Btn {
                text: @tr("Network");
                kind: BtnKind.ghost;
                width: 150px;
                clicked => {
                    Network.load();
                    Nav.page = 9;
                }
            }
            Btn {
                text: @tr("Menu");
                icon: @image-url("icons/menu.svg");
                kind: BtnKind.ghost;
                width: 150px;
                clicked => { Overlay.menu-open = true; }
            }
        }
        if Printer.conn == Conn.not-ready: HorizontalLayout {
            alignment: center;
            spacing: Theme.gap;
            Btn { text: @tr("Restart"); width: 200px; clicked => { Actions.restart(); } }
            Btn { text: @tr("Firmware restart"); kind: BtnKind.accent; width: 220px; clicked => { Actions.firmware-restart(); } }
            Btn {
                text: @tr("Menu");
                icon: @image-url("icons/menu.svg");
                kind: BtnKind.ghost;
                width: 150px;
                clicked => { Overlay.menu-open = true; }
            }
        }
    }
}

component SheetTitle inherits HorizontalLayout {
    in property <string> text;
    callback close();
    spacing: 10px;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-l;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Btn {
        text: @tr("Close");
        kind: BtnKind.ghost;
        width: 130px;
        clicked => { root.close(); }
    }
}

component MenuTile inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    callback clicked();

    // Equal widths in a row, whatever the label length
    preferred-width: 100px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-l;
    background: ta.pressed ? Theme.border : root.active ? Theme.surface-2 : Theme.bg;
    border-width: root.active ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        alignment: center;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.active ? Theme.accent : Theme.text;
                width: 34px;
                height: 34px;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { Screensaver.activity(); } }
        clicked => { root.clicked(); }
    }
}

// All screens as big tiles; replaces the side navigation of earlier versions.
export component MenuSheet inherits Scrim {
    dismiss => { Overlay.menu-open = false; }

    property <[{ icon: image, text: string, page: int }]> row1: [
        { icon: @image-url("icons/home.svg"), text: @tr("Home"), page: 0 },
        { icon: @image-url("icons/thermo.svg"), text: @tr("Temperature"), page: 1 },
        { icon: @image-url("icons/move.svg"), text: @tr("Move"), page: 2 },
        { icon: @image-url("icons/extrude.svg"), text: @tr("Filament"), page: 3 },
    ];
    property <[{ icon: image, text: string, page: int }]> row2: [
        { icon: @image-url("icons/files.svg"), text: @tr("Files"), page: 4 },
        { icon: @image-url("icons/macro.svg"), text: @tr("Macros"), page: 5 },
        { icon: @image-url("icons/console.svg"), text: @tr("Console"), page: 6 },
        { icon: @image-url("icons/system.svg"), text: @tr("System"), page: 7 },
    ];

    function go(page: int) {
        Nav.page = page;
        Overlay.menu-open = false;
    }

    Dialog {
        width: root.width - 32px;
        height: root.height - 32px;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            SheetTitle {
                text: @tr("Menu");
                close => { Overlay.menu-open = false; }
            }
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;
                for item in root.row1: MenuTile {
                    icon: item.icon;
                    text: item.text;
                    // Z calibration (11) and Bed mesh (12) are sub-pages of Move
                    active: Nav.page == item.page || (item.page == 2 && (Nav.page == 11 || Nav.page == 12));
                    clicked => { root.go(item.page); }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;
                for item in root.row2: MenuTile {
                    icon: item.icon;
                    text: item.text;
                    // Settings (8), Network (9) and Updates (10) are sub-pages of System
                    active: Nav.page == item.page || (item.page == 7 && Nav.page >= 8 && Nav.page <= 10);
                    clicked => { root.go(item.page); }
                }
            }
        }
    }
}

// Adjustments during a print, as a sheet from the bottom.
export component TuneSheet inherits Scrim {
    dismiss => { Overlay.tune-open = false; }

    Dialog {
        width: min(root.width - 32px, 660px);
        height: 300px;
        y: root.height - self.height - 16px;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            SheetTitle {
                text: @tr("Tune");
                close => { Overlay.tune-open = false; }
            }
            HorizontalLayout {
                spacing: 12px;
                Stepper {
                    label: @tr("Speed");
                    value: Printer.job.speed-factor + "%";
                    minus => { Actions.gcode("M220 S" + max(10, Printer.job.speed-factor - 10)); }
                    plus => { Actions.gcode("M220 S" + (Printer.job.speed-factor + 10)); }
                }
                Stepper {
                    label: @tr("Flow");
                    value: Printer.job.flow-factor + "%";
                    minus => { Actions.gcode("M221 S" + max(50, Printer.job.flow-factor - 1)); }
                    plus => { Actions.gcode("M221 S" + (Printer.job.flow-factor + 1)); }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Stepper {
                    label: @tr("Z offset");
                    value: Printer.job.z-offset;
                    minus => { Actions.gcode("SET_GCODE_OFFSET Z_ADJUST=-0.01 MOVE=1"); }
                    plus => { Actions.gcode("SET_GCODE_OFFSET Z_ADJUST=0.01 MOVE=1"); }
                }
                if Printer.has-part-fan: Stepper {
                    label: @tr("Part cooling");
                    value: round(Printer.part-fan * 100) + "%";
                    minus => { Actions.set-fan("fan", max(0, Printer.part-fan - 0.1)); }
                    plus => { Actions.set-fan("fan", min(1, Printer.part-fan + 0.1)); }
                }
            }
        }
    }
}
