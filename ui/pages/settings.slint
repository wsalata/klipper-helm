import { Theme } from "../theme.slint";
import { Overlay, Nav, Settings, Preset, Strings } from "../state.slint";
import { Btn, BtnKind, Card, Caption, SettingRow } from "../widgets.slint";
import { ScrollView } from "std-widgets.slint";

component PresetRow inherits HorizontalLayout {
    in property <Preset> preset;
    in property <int> index;
    spacing: 6px;
    height: 48px;
    Btn {
        text: root.preset.name;
        font-size: Theme.font-s;
        horizontal-stretch: 2;
        clicked => { Overlay.ask-text("name:" + root.index, @tr("Preset name"), root.preset.name); }
    }
    Btn {
        text: round(root.preset.extruder) + "°";
        font-size: Theme.font-s;
        horizontal-stretch: 1;
        clicked => { Overlay.ask-number("ext:" + root.index, @tr("{} - nozzle", root.preset.name), root.preset.extruder, "°"); }
    }
    Btn {
        text: round(root.preset.bed) + "°";
        font-size: Theme.font-s;
        horizontal-stretch: 1;
        clicked => { Overlay.ask-number("bed:" + root.index, @tr("{} - bed", root.preset.name), root.preset.bed, "°"); }
    }
    Btn {
        text: "X";
        kind: BtnKind.ghost;
        font-size: Theme.font-s;
        width: 48px;
        clicked => { Settings.preset-remove(root.index); }
    }
}

export component SettingsPage inherits Rectangle {
    VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        HorizontalLayout {
            spacing: Theme.gap;
            // The title is in the header
            alignment: end;
            Btn { text: @tr("Cancel"); kind: BtnKind.ghost; width: 120px; clicked => { Nav.page = 7; } }
            Btn { text: @tr("Save"); kind: BtnKind.accent; width: 120px; clicked => { Settings.save(); } }
        }

        if Settings.error-code != "": Text {
            text: Strings.settings-error(Settings.error-code, Settings.error-arg);
            color: Theme.danger;
            font-size: Theme.font-s;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;

            Card {
                // Half of the page (padding on both sides, gap between the cards)
                width: (root.width - 3 * Theme.gap) / 2;
                // Scrolls when the screen is too short for all rows
                ScrollView {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Caption { text: @tr("Connection"); }
                    SettingRow {
                        label: "Moonraker";
                        value: Settings.url;
                        clicked => { Overlay.ask-text("url", @tr("Moonraker address (ws://host:7125/websocket)"), Settings.url); }
                    }
                    Caption { text: @tr("Manual movement"); }
                    SettingRow {
                        label: @tr("XY speed");
                        value: round(Settings.xy-speed) + " mm/s";
                        clicked => { Overlay.ask-number("xy", @tr("XY speed [mm/s]"), Settings.xy-speed, " mm/s"); }
                    }
                    SettingRow {
                        label: @tr("Z speed");
                        value: round(Settings.z-speed) + " mm/s";
                        clicked => { Overlay.ask-number("z", @tr("Z speed [mm/s]"), Settings.z-speed, " mm/s"); }
                    }
                    Caption { text: @tr("Language"); }
                    HorizontalLayout {
                        spacing: 4px;
                        // Language names are written in their own language, so they are not translated
                        for lang in [
                            { code: "auto", name: @tr("System") },
                            { code: "en", name: "English" },
                            { code: "pl", name: "Polski" },
                        ]: Btn {
                            text: lang.name;
                            font-size: Theme.font-s;
                            min-height: 44px;
                            active: Settings.language == lang.code;
                            clicked => { Settings.language = lang.code; }
                        }
                    }
                    Caption {
                        text: @tr("File: {}", Settings.config-path);
                        wrap: word-wrap;
                        font-size: 12px;
                    }
                }
                }
            }

            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        Caption { text: @tr("Presets (name, nozzle, bed)"); horizontal-stretch: 1; }
                        Btn {
                            text: @tr("+ Add");
                            font-size: Theme.font-s;
                            min-height: 40px;
                            width: 100px;
                            clicked => { Settings.preset-add(@tr("New")); }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            spacing: 6px;
                            for p[i] in Settings.presets: PresetRow { preset: p; index: i; }
                        }
                    }
                    Caption { text: @tr("Screen saver"); }
                    HorizontalLayout {
                        spacing: 4px;
                        for option in [
                            { minutes: 0, name: @tr("Off") },
                            { minutes: 2, name: @tr("{} min", 2) },
                            { minutes: 5, name: @tr("{} min", 5) },
                            { minutes: 10, name: @tr("{} min", 10) },
                            { minutes: 30, name: @tr("{} min", 30) },
                        ]: Btn {
                            text: option.name;
                            font-size: Theme.font-s;
                            min-height: 44px;
                            active: Settings.screensaver-minutes == option.minutes;
                            clicked => { Settings.screensaver-minutes = option.minutes; }
                        }
                    }
                }
            }
        }
    }
}
