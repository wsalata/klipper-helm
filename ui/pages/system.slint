import { Theme } from "../theme.slint";
import { Printer, Overlay, Nav, Settings, Strings, Network } from "../state.slint";
import { Btn, BtnKind, Card, Caption, InfoRow } from "../widgets.slint";

export component SystemPage inherits Rectangle {
    HorizontalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                Caption { text: @tr("Information"); }
                InfoRow { label: @tr("Host"); value: Printer.hostname; }
                InfoRow { label: @tr("State"); value: Strings.status(Printer.status); }
                InfoRow { label: "Klipper"; value: Printer.klipper-version; }
                InfoRow { label: "Moonraker"; value: Printer.moonraker-url; }
                if Strings.status-message() != "": Text {
                    text: Strings.status-message();
                    color: Theme.text-dim;
                    font-size: Theme.font-s;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Btn {
                        text: @tr("Panel settings");
                        icon: @image-url("../icons/system.svg");
                        clicked => {
                            Settings.load();
                            Nav.page = 8;
                        }
                    }
                    Btn {
                        text: @tr("Network");
                        icon: @image-url("../icons/wifi.svg");
                        clicked => {
                            Network.load();
                            Nav.page = 9;
                        }
                    }
                }
            }
        }

        Card {
            width: 240px;
            VerticalLayout {
                padding: 12px;
                spacing: Theme.gap;
                Caption { text: "Klipper"; }
                Btn { text: @tr("Restart"); clicked => { Overlay.ask(@tr("Restart Klipper?"), "restart", ""); } }
                Btn { text: @tr("Firmware restart"); clicked => { Overlay.ask(@tr("Restart the firmware (MCU)?"), "firmware-restart", ""); } }
                Rectangle { vertical-stretch: 1; }
                Caption { text: @tr("Computer"); }
                Btn { text: @tr("Reboot"); clicked => { Overlay.ask(@tr("Reboot the printer computer?"), "reboot", ""); } }
                Btn { text: @tr("Shut down"); kind: BtnKind.danger; clicked => { Overlay.ask(@tr("Shut down the printer computer?"), "shutdown", ""); } }
            }
        }
    }
}
