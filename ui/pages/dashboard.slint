import { Theme } from "../theme.slint";
import { Printer, Actions, Overlay, Nav, Strings, Status } from "../state.slint";
import { Btn, BtnKind } from "../widgets.slint";

// Temperature or fan tile beside the thumbnail: icon, current value and target, with a
// thin bar of how far the heater has got to its target. Taps open Tune.
component StatTile inherits Rectangle {
    in property <image> icon;
    in property <color> tint;
    in property <string> label;
    in property <string> value;
    in property <string> target;
    // 0..1 along the bottom edge, -1 for none
    in property <float> level: -1;
    // Heating: the icon breathes
    in property <bool> pulse;
    callback clicked();

    height: 72px;
    border-radius: Theme.radius;
    clip: true;
    background: ta.pressed ? Theme.border : Theme.surface;
    accessible-role: button;
    accessible-label: root.label + " " + root.value + " " + root.target;
    accessible-action-default => { root.clicked(); }

    // Accent strip on the left in the tile's colour
    Rectangle { x: 0; width: 4px; height: parent.height; background: root.tint; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: root.tint.transparentize(0.82);
                Image {
                    source: root.icon;
                    colorize: root.tint;
                    width: 24px;
                    height: 24px;
                    // animation-tick() is only read while heating, so idle tiles do not redraw
                    opacity: root.pulse ? 0.55 + 0.45 * abs(sin(animation-tick() / 1100ms * 180deg)) : 1;
                }
            }
        }
        // The icon says what it is; the name is only for screen readers
        HorizontalLayout {
            alignment: start;
            spacing: 6px;
            Text {
                text: root.value;
                color: Theme.text;
                font-family: Theme.display;
                font-size: Theme.font-xl;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: root.target;
                color: Theme.text-dim;
                font-size: Theme.font-m;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    if root.level >= 0: Rectangle {
        x: 0;
        y: parent.height - 3px;
        width: parent.width * clamp(root.level, 0, 1);
        height: 3px;
        background: @linear-gradient(90deg, root.tint.transparentize(0.6) 0%, root.tint 100%);
        animate width { duration: 400ms; easing: ease-out; }
    }

    ta := TouchArea { clicked => { root.clicked(); } }
}

// Full-width print progress: a gradient fill with a sheen running along it while printing.
component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <bool> paused;

    height: 14px;
    border-radius: self.height / 2;
    background: Theme.surface-2;

    Rectangle {
        x: 0;
        width: max(parent.height, parent.width * clamp(root.value, 0, 1));
        height: parent.height;
        border-radius: parent.border-radius;
        clip: true;
        background: root.paused ? Theme.warn : @linear-gradient(90deg, Theme.accent.darker(0.45) 0%, Theme.accent 100%);
        animate width { duration: 600ms; easing: ease-out; }

        if !root.paused: Rectangle {
            property <float> phase: mod(animation-tick(), 2400ms) / 2400ms;
            width: 90px;
            x: -self.width + (parent.width + self.width) * self.phase;
            background: @linear-gradient(90deg, #ffffff00 0%, #ffffff50 50%, #ffffff00 100%);
        }
    }
}

// Concept C: one glance from across the room. The remaining time dominates; the thumbnail,
// temperatures and fan sit beside it, the progress bar spans the screen. Tiles open Tune.
export component DashboardPage inherits Rectangle {
    property <bool> active: Printer.printing;
    property <bool> finished: !Printer.printing && Printer.job.filename != "";
    property <int> minutes: Printer.job.remaining-minutes;

    // 95 -> "1:35", 42 -> "42"
    pure function big-time(m: int) -> string {
        if (m >= 60) {
            return floor(m / 60) + ":" + (mod(m, 60) < 10 ? "0" : "") + mod(m, 60);
        }
        return m + "";
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 16px;
        spacing: 12px;

        // Equal spacers above and below keep the job block in the middle of the free space
        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: 18px;

            Rectangle {
                width: 232px;
                height: 232px;
                border-radius: Theme.radius-l;
                background: Theme.surface;
                clip: true;
                if Printer.job-thumb.width > 0: Image {
                    source: Printer.job-thumb;
                    width: parent.width - 24px;
                    height: parent.height - 24px;
                    image-fit: contain;
                }
                if Printer.job-thumb.width == 0: Image {
                    source: @image-url("../icons/files.svg");
                    colorize: Theme.border;
                    width: 56px;
                    height: 56px;
                }
            }

            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                alignment: center;

                Text {
                    text: root.active || root.finished ? Printer.job.filename : Printer.hostname;
                    color: Theme.text;
                    font-size: Theme.font-m;
                    overflow: elide;
                }

                // Printing or paused: remaining time and end time
                if root.active: VerticalLayout {
                    Text {
                        text: Printer.job.state == "paused" ? @tr("Paused, remaining") : @tr("Remaining");
                        color: Printer.job.state == "paused" ? Theme.warn : Theme.text-dim;
                        font-size: Theme.font-s;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Text {
                            text: root.minutes < 0 ? "-" : root.big-time(root.minutes);
                            color: Theme.text;
                            font-family: Theme.display;
                            font-weight: 700;
                            font-size: 84px;
                            vertical-alignment: bottom;
                        }
                        Text {
                            text: root.minutes >= 60 ? "h" : "min";
                            color: Theme.accent;
                            font-family: Theme.display;
                            font-weight: 600;
                            font-size: 36px;
                            vertical-alignment: bottom;
                        }
                    }
                    if Printer.job.eta-clock != "": Text {
                        text: @tr("finishes around {}", Printer.job.eta-clock);
                        color: Theme.text-dim;
                        font-size: Theme.font-m;
                    }
                }

                // Finished, cancelled or failed: outcome and print time
                if root.finished: VerticalLayout {
                    Text {
                        text: Strings.status(Printer.status);
                        color: Printer.job.state == "complete" ? Theme.accent : Theme.danger-text;
                        font-size: Theme.font-s;
                    }
                    Text {
                        text: Printer.job.elapsed;
                        color: Theme.text;
                        font-family: Theme.display;
                        font-weight: 700;
                        font-size: 64px;
                    }
                    Text {
                        text: @tr("print time · filament {}", Printer.job.filament);
                        color: Theme.text-dim;
                        font-size: Theme.font-s;
                        wrap: word-wrap;
                    }
                }

                // Idle
                if !root.active && !root.finished: VerticalLayout {
                    Text { text: @tr("State"); color: Theme.text-dim; font-size: Theme.font-s; }
                    Text {
                        text: Strings.status(Printer.status);
                        color: Theme.text;
                        font-family: Theme.display;
                        font-weight: 700;
                        font-size: 56px;
                        overflow: elide;
                    }
                }
            }

            // Temperatures and fan, all adjusted in the Tune sheet
            VerticalLayout {
                width: 220px;
                spacing: 8px;
                alignment: center;
                for h in Printer.top-heaters: StatTile {
                    icon: h.role == "bed" ? @image-url("../icons/bed.svg") : @image-url("../icons/nozzle.svg");
                    tint: h.target > 0 ? Theme.hot : Theme.text-dim;
                    label: Strings.heater-name(h);
                    value: round(h.temp) + "°";
                    target: h.target > 0 ? "/ " + round(h.target) + "°" : "";
                    level: h.target > 0 ? h.temp / h.target : -1;
                    pulse: h.target > 0 && h.temp < h.target - 2;
                    clicked => { Overlay.tune-open = true; }
                }
                if Printer.has-part-fan: StatTile {
                    icon: @image-url("../icons/fan.svg");
                    tint: Printer.part-fan > 0 ? Theme.accent : Theme.text-dim;
                    label: @tr("Part cooling");
                    value: round(Printer.part-fan * 100) + "%";
                    level: Printer.part-fan > 0 ? Printer.part-fan : -1;
                    clicked => { Overlay.tune-open = true; }
                }
            }
        }

        // Progress across the whole width
        if root.active: VerticalLayout {
            spacing: 6px;
            vertical-stretch: 0;
            ProgressBar {
                value: Printer.job.progress;
                paused: Printer.job.state == "paused";
            }
            HorizontalLayout {
                Text {
                    text: round(Printer.job.progress * 100) + "%";
                    color: Printer.job.state == "paused" ? Theme.warn : Theme.accent;
                    font-family: Theme.display;
                    font-size: Theme.font-l;
                    font-weight: 700;
                    vertical-alignment: bottom;
                }
                Text {
                    text: @tr("layer {} · Z {}", Printer.job.layer, Printer.position.z);
                    color: Theme.text-dim;
                    font-size: Theme.font-s;
                    horizontal-alignment: right;
                    vertical-alignment: bottom;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            height: 60px;
            spacing: 10px;
            Btn {
                text: @tr("Menu");
                icon: @image-url("../icons/menu.svg");
                kind: BtnKind.ghost;
                width: 132px;
                clicked => { Overlay.menu-open = true; }
            }
            Rectangle { horizontal-stretch: 1; }

            if Printer.job.state == "printing": Btn {
                text: @tr("Pause");
                kind: BtnKind.accent;
                width: 150px;
                clicked => { Actions.pause(); }
            }
            if Printer.job.state == "paused": Btn {
                text: @tr("Resume");
                kind: BtnKind.accent;
                width: 150px;
                clicked => { Actions.resume(); }
            }
            if root.active: Btn {
                text: @tr("Tune");
                width: 150px;
                clicked => { Overlay.tune-open = true; }
            }
            if root.active: Btn {
                text: @tr("Cancel");
                kind: BtnKind.danger-outline;
                width: 150px;
                clicked => { Overlay.ask(@tr("Cancel the current print?"), "cancel", ""); }
            }

            if root.finished: Btn {
                text: @tr("Print again");
                kind: BtnKind.accent;
                width: 190px;
                clicked => {
                    Overlay.open-file(Printer.job.filename);
                    Actions.file-details(Printer.job.filename);
                }
            }
            if !root.active: Btn {
                text: @tr("Files");
                kind: root.finished ? BtnKind.normal : BtnKind.accent;
                width: 150px;
                clicked => { Nav.page = 4; }
            }
            if !root.active && !root.finished: Btn {
                text: @tr("Temperature");
                width: 170px;
                clicked => { Nav.page = 1; }
            }
        }
    }
}
