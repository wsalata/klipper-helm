import { Theme } from "../theme.slint";
import { Printer, Actions, Overlay, Nav } from "../state.slint";
import { Btn, BtnKind, Card, Caption, Bar, HeaterTile, InfoRow } from "../widgets.slint";

// Krokowa regulacja wartości w trakcie druku (prędkość, przepływ, Z-offset).
component Stepper inherits Card {
    in property <string> label;
    in property <string> value;
    callback minus();
    callback plus();
    HorizontalLayout {
        padding: 6px;
        spacing: 6px;
        Btn { text: "-"; width: 52px; font-size: Theme.font-l; clicked => { root.minus(); } }
        VerticalLayout {
            alignment: center;
            Caption { text: root.label; horizontal-alignment: center; }
            Text {
                text: root.value;
                color: Theme.text;
                font-size: Theme.font-m;
                font-weight: 700;
                horizontal-alignment: center;
            }
        }
        Btn { text: "+"; width: 52px; font-size: Theme.font-l; clicked => { root.plus(); } }
    }
}

export component DashboardPage inherits Rectangle {
    VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        HorizontalLayout {
            spacing: Theme.gap;
            height: 112px;
            for h in Printer.heaters: HeaterTile {
                heater: h;
                clicked => { Overlay.edit-temp(h); }
            }
        }

        Card {
            vertical-stretch: 1;

            // Bezczynność: zaproszenie do wyboru pliku
            if !Printer.printing && Printer.job.filename == "": VerticalLayout {
                alignment: center;
                spacing: 12px;
                Text {
                    text: Printer.status-label;
                    font-size: Theme.font-l;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    Btn {
                        text: "Wybierz plik do druku";
                        kind: BtnKind.accent;
                        width: 280px;
                        clicked => { Nav.page = 4; }
                    }
                }
            }

            // Druk trwa lub właśnie się zakończył
            if Printer.printing || Printer.job.filename != "": VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: Printer.job.filename;
                        color: Theme.text;
                        font-size: Theme.font-m;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: round(Printer.job.progress * 100) + "%";
                        color: Theme.text;
                        font-size: Theme.font-l;
                        font-weight: 700;
                        horizontal-stretch: 0;
                    }
                }
                Bar {
                    height: 14px;
                    value: Printer.job.progress;
                    fill: Printer.job.state == "paused" ? Theme.warn
                        : Printer.job.state == "error" || Printer.job.state == "cancelled" ? Theme.danger
                        : Printer.job.state == "complete" ? Theme.ok
                        : Theme.accent;
                }
                if Printer.job.message != "": Caption { text: Printer.job.message; overflow: elide; }

                HorizontalLayout {
                    spacing: 24px;
                    VerticalLayout {
                        spacing: 4px;
                        InfoRow { label: "Czas"; value: Printer.job.elapsed; }
                        InfoRow { label: "Pozostało"; value: Printer.job.remaining; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        InfoRow { label: "Warstwa"; value: Printer.job.layer; }
                        InfoRow { label: "Z"; value: Printer.position.z; }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        InfoRow { label: "Filament"; value: Printer.job.filament; }
                        InfoRow { label: "Z-offset"; value: Printer.job.z-offset; }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                if Printer.printing: HorizontalLayout {
                    spacing: Theme.gap;
                    if Printer.job.state == "printing": Btn {
                        text: "Pauza";
                        kind: BtnKind.normal;
                        clicked => { Actions.pause(); }
                    }
                    if Printer.job.state == "paused": Btn {
                        text: "Wznów";
                        kind: BtnKind.accent;
                        clicked => { Actions.resume(); }
                    }
                    Btn {
                        text: "Anuluj druk";
                        kind: BtnKind.danger;
                        clicked => { Overlay.ask("Anulować bieżący wydruk?", "cancel", ""); }
                    }
                }
                if !Printer.printing: HorizontalLayout {
                    spacing: Theme.gap;
                    Btn {
                        text: "Drukuj ponownie";
                        kind: BtnKind.accent;
                        clicked => { Overlay.open-file(Printer.job.filename); Actions.file-details(Printer.job.filename); }
                    }
                    Btn {
                        text: "Wybierz inny plik";
                        clicked => { Nav.page = 4; }
                    }
                }
            }
        }

        if Printer.printing: HorizontalLayout {
            spacing: Theme.gap;
            height: 64px;
            Stepper {
                label: "Prędkość";
                value: Printer.job.speed-factor + "%";
                minus => { Actions.gcode("M220 S" + max(10, Printer.job.speed-factor - 10)); }
                plus => { Actions.gcode("M220 S" + (Printer.job.speed-factor + 10)); }
            }
            Stepper {
                label: "Przepływ";
                value: Printer.job.flow-factor + "%";
                minus => { Actions.gcode("M221 S" + max(50, Printer.job.flow-factor - 1)); }
                plus => { Actions.gcode("M221 S" + (Printer.job.flow-factor + 1)); }
            }
            Stepper {
                label: "Z-offset";
                value: Printer.job.z-offset;
                minus => { Actions.gcode("SET_GCODE_OFFSET Z_ADJUST=-0.01 MOVE=1"); }
                plus => { Actions.gcode("SET_GCODE_OFFSET Z_ADJUST=0.01 MOVE=1"); }
            }
        }
    }
}
