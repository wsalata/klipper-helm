import { Theme } from "../theme.slint";
import { Printer, Actions, Overlay, Nav, Strings } from "../state.slint";
import { Btn, BtnKind, Card, Caption, Bar, HeaterTile, InfoRow, Thumb } from "../widgets.slint";

// Step adjustment during a print (speed, flow, Z offset).
component Stepper inherits Card {
    in property <string> label;
    in property <string> value;
    callback minus();
    callback plus();
    HorizontalLayout {
        padding: 6px;
        spacing: 6px;
        Btn { text: "-"; width: 52px; font-size: Theme.font-l; clicked => { root.minus(); } }
        VerticalLayout {
            alignment: center;
            Caption { text: root.label; horizontal-alignment: center; }
            Text {
                text: root.value;
                color: Theme.text;
                font-size: Theme.font-m;
                font-weight: 700;
                horizontal-alignment: center;
            }
        }
        Btn { text: "+"; width: 52px; font-size: Theme.font-l; clicked => { root.plus(); } }
    }
}

export component DashboardPage inherits Rectangle {
    VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        HorizontalLayout {
            spacing: Theme.gap;
            height: 112px;
            for h in Printer.heaters: HeaterTile {
                heater: h;
                clicked => { Overlay.edit-temp(h); }
            }
        }

        Card {
            vertical-stretch: 1;

            // Idle: prompt to pick a file
            if !Printer.printing && Printer.job.filename == "": VerticalLayout {
                alignment: center;
                spacing: 12px;
                Text {
                    text: Strings.status(Printer.status);
                    font-size: Theme.font-l;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    Btn {
                        text: @tr("Choose a file to print");
                        kind: BtnKind.accent;
                        width: 280px;
                        clicked => { Nav.page = 4; }
                    }
                }
            }

            // A print is running or has just finished
            if Printer.printing || Printer.job.filename != "": VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 14px;
                    vertical-stretch: 1;
                    if Printer.job-thumb.width > 0: Thumb {
                        source: Printer.job-thumb;
                        width: 140px;
                    }
                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: Printer.job.filename;
                                color: Theme.text;
                                font-size: Theme.font-m;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: round(Printer.job.progress * 100) + "%";
                                color: Theme.text;
                                font-size: Theme.font-l;
                                font-weight: 700;
                                horizontal-stretch: 0;
                            }
                        }
                        Bar {
                            height: 14px;
                            value: Printer.job.progress;
                            fill: Printer.job.state == "paused" ? Theme.warn
                                : Printer.job.state == "error" || Printer.job.state == "cancelled" ? Theme.danger
                                : Printer.job.state == "complete" ? Theme.ok
                                : Theme.accent;
                        }
                        if Printer.job.message != "": Caption { text: Printer.job.message; overflow: elide; }

                        HorizontalLayout {
                            spacing: 24px;
                            VerticalLayout {
                                spacing: 4px;
                                InfoRow { label: @tr("Elapsed"); value: Printer.job.elapsed; }
                                InfoRow { label: @tr("Remaining"); value: Printer.job.remaining; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                InfoRow { label: @tr("Layer"); value: Printer.job.layer; }
                                InfoRow { label: "Z"; value: Printer.position.z; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                InfoRow { label: @tr("Filament"); value: Printer.job.filament; }
                                InfoRow { label: "Z-offset"; value: Printer.job.z-offset; }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                if Printer.printing: HorizontalLayout {
                    spacing: Theme.gap;
                    if Printer.job.state == "printing": Btn {
                        text: @tr("Pause");
                        kind: BtnKind.normal;
                        clicked => { Actions.pause(); }
                    }
                    if Printer.job.state == "paused": Btn {
                        text: @tr("Resume");
                        kind: BtnKind.accent;
                        clicked => { Actions.resume(); }
                    }
                    Btn {
                        text: @tr("Cancel print");
                        kind: BtnKind.danger;
                        clicked => { Overlay.ask(@tr("Cancel the current print?"), "cancel", ""); }
                    }
                }
                if !Printer.printing: HorizontalLayout {
                    spacing: Theme.gap;
                    Btn {
                        text: @tr("Print again");
                        kind: BtnKind.accent;
                        clicked => { Overlay.open-file(Printer.job.filename); Actions.file-details(Printer.job.filename); }
                    }
                    Btn {
                        text: @tr("Choose another file");
                        clicked => { Nav.page = 4; }
                    }
                }
            }
        }

        if Printer.printing: HorizontalLayout {
            spacing: Theme.gap;
            height: 64px;
            Stepper {
                label: @tr("Speed");
                value: Printer.job.speed-factor + "%";
                minus => { Actions.gcode("M220 S" + max(10, Printer.job.speed-factor - 10)); }
                plus => { Actions.gcode("M220 S" + (Printer.job.speed-factor + 10)); }
            }
            Stepper {
                label: @tr("Flow");
                value: Printer.job.flow-factor + "%";
                minus => { Actions.gcode("M221 S" + max(50, Printer.job.flow-factor - 1)); }
                plus => { Actions.gcode("M221 S" + (Printer.job.flow-factor + 1)); }
            }
            Stepper {
                label: "Z-offset";
                value: Printer.job.z-offset;
                minus => { Actions.gcode("SET_GCODE_OFFSET Z_ADJUST=-0.01 MOVE=1"); }
                plus => { Actions.gcode("SET_GCODE_OFFSET Z_ADJUST=0.01 MOVE=1"); }
            }
        }
    }
}
