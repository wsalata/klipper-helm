import { Theme } from "../theme.slint";
import { Printer, Actions, Overlay, Nav, Strings, Status } from "../state.slint";
import { Btn, BtnKind, Caption, Bar, Thumb } from "../widgets.slint";

// Concept C: one glance from across the room. The remaining time dominates;
// everything else is one tap away (chips, Tune, Menu).
export component DashboardPage inherits Rectangle {
    property <bool> active: Printer.printing;
    property <bool> finished: !Printer.printing && Printer.job.filename != "";
    property <int> minutes: Printer.job.remaining-minutes;

    // 95 -> "1:35", 42 -> "42"
    pure function big-time(m: int) -> string {
        if (m >= 60) {
            return floor(m / 60) + ":" + (mod(m, 60) < 10 ? "0" : "") + mod(m, 60);
        }
        return m + "";
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 16px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 28px;
            vertical-stretch: 1;

            VerticalLayout {
                width: 270px;
                spacing: 10px;
                if Printer.job-thumb.width > 0: Thumb {
                    source: Printer.job-thumb;
                    height: 230px;
                    border-radius: Theme.radius-l;
                }
                if Printer.job-thumb.width == 0: Rectangle {
                    height: 230px;
                    border-radius: Theme.radius-l;
                    background: Theme.surface;
                    Image {
                        source: @image-url("../icons/files.svg");
                        colorize: Theme.border;
                        width: 64px;
                        height: 64px;
                    }
                }
                Text {
                    text: root.active || root.finished ? Printer.job.filename : Printer.hostname;
                    color: Theme.text-dim;
                    font-size: Theme.font-s;
                    overflow: elide;
                }
                Rectangle { vertical-stretch: 1; }
            }

            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;

                // Printing or paused: remaining time, end time, progress
                if root.active: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: Printer.job.state == "paused" ? @tr("Paused, remaining") : @tr("Remaining");
                        color: Printer.job.state == "paused" ? Theme.warn : Theme.text-dim;
                        font-size: 15px;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 10px;
                        Text {
                            text: root.minutes < 0 ? "-" : root.big-time(root.minutes);
                            color: Theme.text;
                            font-family: Theme.display;
                            font-weight: 700;
                            font-size: 96px;
                            vertical-alignment: bottom;
                        }
                        Text {
                            text: root.minutes >= 60 ? "h" : "min";
                            color: Theme.text-dim;
                            font-family: Theme.display;
                            font-weight: 600;
                            font-size: 44px;
                            vertical-alignment: bottom;
                        }
                    }
                    if Printer.job.eta-clock != "": Text {
                        text: @tr("finishes around {}", Printer.job.eta-clock);
                        color: Theme.text;
                        font-size: Theme.font-m;
                    }
                    Rectangle { height: 6px; }
                    Bar {
                        height: 10px;
                        value: Printer.job.progress;
                        fill: Printer.job.state == "paused" ? Theme.warn : Theme.accent;
                    }
                    Text {
                        text: @tr("{}% · layer {} · Z {}", round(Printer.job.progress * 100), Printer.job.layer, Printer.position.z);
                        color: Theme.text-dim;
                        font-size: Theme.font-s;
                    }
                }

                // Finished, cancelled or failed: outcome and print time
                if root.finished: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: Strings.status(Printer.status);
                        color: Printer.job.state == "complete" ? Theme.accent : Theme.danger-text;
                        font-size: 15px;
                    }
                    Text {
                        text: Printer.job.elapsed;
                        color: Theme.text;
                        font-family: Theme.display;
                        font-weight: 700;
                        font-size: 72px;
                    }
                    Text {
                        text: @tr("print time · filament {}", Printer.job.filament);
                        color: Theme.text-dim;
                        font-size: Theme.font-m;
                    }
                }

                // Idle
                if !root.active && !root.finished: VerticalLayout {
                    spacing: 6px;
                    Text { text: @tr("State"); color: Theme.text-dim; font-size: 15px; }
                    Text {
                        text: Strings.status(Printer.status);
                        color: Theme.text;
                        font-family: Theme.display;
                        font-weight: 700;
                        font-size: 72px;
                        overflow: elide;
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // Temperatures and fan, one tap from their controls
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    for h in Printer.top-heaters: Btn {
                        text: Strings.heater-name(h) + " " + round(h.temp) + "/" + round(h.target) + "°";
                        font-size: Theme.font-s;
                        min-height: 44px;
                        clicked => { Overlay.edit-temp(h); }
                    }
                    if Printer.has-part-fan: Btn {
                        text: @tr("Fan {}%", round(Printer.part-fan * 100));
                        font-size: Theme.font-s;
                        min-height: 44px;
                        clicked => { Overlay.tune-open = true; }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 60px;
            spacing: 10px;
            Btn {
                text: @tr("Menu");
                icon: @image-url("../icons/menu.svg");
                kind: BtnKind.ghost;
                width: 132px;
                clicked => { Overlay.menu-open = true; }
            }
            Rectangle { horizontal-stretch: 1; }

            if Printer.job.state == "printing": Btn {
                text: @tr("Pause");
                kind: BtnKind.accent;
                width: 150px;
                clicked => { Actions.pause(); }
            }
            if Printer.job.state == "paused": Btn {
                text: @tr("Resume");
                kind: BtnKind.accent;
                width: 150px;
                clicked => { Actions.resume(); }
            }
            if root.active: Btn {
                text: @tr("Tune");
                width: 150px;
                clicked => { Overlay.tune-open = true; }
            }
            if root.active: Btn {
                text: @tr("Cancel");
                kind: BtnKind.danger-outline;
                width: 150px;
                clicked => { Overlay.ask(@tr("Cancel the current print?"), "cancel", ""); }
            }

            if root.finished: Btn {
                text: @tr("Print again");
                kind: BtnKind.accent;
                width: 190px;
                clicked => {
                    Overlay.open-file(Printer.job.filename);
                    Actions.file-details(Printer.job.filename);
                }
            }
            if !root.active: Btn {
                text: @tr("Files");
                kind: root.finished ? BtnKind.normal : BtnKind.accent;
                width: 150px;
                clicked => { Nav.page = 4; }
            }
            if !root.active && !root.finished: Btn {
                text: @tr("Temperature");
                width: 170px;
                clicked => { Nav.page = 1; }
            }
        }
    }
}
