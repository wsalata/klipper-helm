import { Theme } from "../theme.slint";
import { Printer, Update, UpdateItem, Overlay } from "../state.slint";
import { Btn, BtnKind, Card, Caption } from "../widgets.slint";
import { ScrollView } from "std-widgets.slint";

component UpdateRow inherits Rectangle {
    in property <UpdateItem> item;
    in property <bool> can-update;
    height: 60px;

    HorizontalLayout {
        padding-left: 4px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.item.name == "system" ? @tr("System packages") : root.item.name;
                color: Theme.text;
                font-weight: 600;
                overflow: elide;
            }
            Caption {
                text: root.item.name == "system"
                        ? (root.item.packages > 0 ? @tr("{} packages to update", root.item.packages) : @tr("Up to date"))
                    : root.item.state == "invalid" ? @tr("{} · installation not recognised, see Mainsail", root.item.version)
                    : root.item.state == "available" && root.item.remote != "" ? root.item.version + " → " + root.item.remote
                    : root.item.state == "available" ? @tr("{} · update available", root.item.version)
                    : @tr("{} · up to date", root.item.version);
                color: root.item.state == "available" ? Theme.accent
                    : root.item.state == "invalid" ? Theme.warn
                    : Theme.text-dim;
                font-size: Theme.font-s;
                overflow: elide;
            }
        }
        if root.item.state == "available": Btn {
            width: 140px;
            text: @tr("Update");
            font-size: Theme.font-s;
            kind: BtnKind.accent;
            enabled: root.can-update;
            clicked => { Update.upgrade(root.item.name); }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

export component UpdatePage inherits Rectangle {
    property <bool> can-update: !Update.busy && !Printer.printing;

    VerticalLayout {
        padding: Theme.gap;
        spacing: Theme.gap;

        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: Theme.gap;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Caption { text: @tr("Klipper Helm {}", Printer.panel-version); }
                        Text {
                            text: Update.error != "" ? Update.error
                                : Update.busy ? (Update.message != "" ? Update.message : @tr("Working..."))
                                : Printer.printing ? @tr("Updates are not possible while printing.")
                                : !Update.loaded ? @tr("Moonraker's update manager is not available.")
                                : "";
                            color: Update.error != "" ? Theme.danger-text : Theme.text-dim;
                            font-size: Theme.font-s;
                            overflow: elide;
                        }
                    }
                    Btn {
                        width: 160px;
                        text: @tr("Check");
                        icon: @image-url("../icons/refresh.svg");
                        font-size: Theme.font-s;
                        enabled: !Update.busy;
                        clicked => { Update.refresh(); }
                    }
                    Btn {
                        width: 160px;
                        text: @tr("Update all");
                        font-size: Theme.font-s;
                        enabled: root.can-update;
                        clicked => { Overlay.ask(@tr("Update everything? Klipper and Moonraker restart during the update."), "update", ""); }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        for item in Update.items: UpdateRow {
                            item: item;
                            can-update: root.can-update;
                        }
                    }
                }
            }
        }
    }
}
